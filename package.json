{
  "name": "ascii-bot-shooter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ASCII Bot Shooter \u2014 an indirect-control ASCII team shooter tournament.",
  "scripts": {
    "dev": "vite",
